# REQUIRED — YouTube Live stream key.
# Get it from: YouTube Studio → Create → Go live → Stream → "Stream key".
# Treat as a secret: anyone with this key can hijack your live channel.
YOUTUBE_STREAM_KEY=

# OPTIONAL — URL to capture. Must include ?broadcast=1 for the 1920×1080
# layout and auto-play music. Defaults to the Railway-hosted dashboard.
# STREAM_URL=https://h-track-production.up.railway.app/?broadcast=1

# OPTIONAL — output canvas + encoder settings. Defaults match YouTube's
# recommended 1080p30 ingest profile.
# WIDTH=1920
# HEIGHT=1080
# FPS=30
# VIDEO_BITRATE=4500k
# AUDIO_BITRATE=128k

# OPTIONAL — RTMP ingest endpoint. Override only if YouTube reroutes you
# to a regional ingest (e.g. b.rtmp.youtube.com).
# YOUTUBE_RTMP=rtmp://a.rtmp.youtube.com/live2
